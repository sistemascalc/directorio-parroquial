{
  "name": "directorio-parroquial",
  "version": "1.1.0",
  "description": "Sistema de domicilios parroquiales original empaquetado para Windows",
  "private": true,
  "author": "Oficina parroquial",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "configure:updates": "node scripts/configure-updates.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "mx.oficina.directorio.parroquial",
    "productName": "Directorio Parroquial",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "updates.js",
      "update-source.json",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Directorio-Parroquial-Instalador-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Directorio Parroquial",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "sistemascalc",
        "repo": "directorio-parroquial",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
